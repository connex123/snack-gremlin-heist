{
  "name": "snack-gremlin-heist",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" },
      "ShotDirectorServer": { "$path": "src/studio/ShotDirectorServer.luau" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": true }
    },
    "Workspace": {
      "$properties": { "FilteringEnabled": true }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 17.6,
        "Brightness": 3,
        "GlobalShadows": true,
        "Outlines": false
      }
    },
    "SoundService": {
      "$properties": { "RespectFilteringEnabled": true }
    }
  }
}
